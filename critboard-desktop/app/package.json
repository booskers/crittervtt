{
  "name": "critboard",
  "productName": "Critter",
  "version": "1.2.4",
  "description": "Critter: a tabletop dice roller and battle map, as a desktop app.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build-www": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win dir && node installer/pack.mjs"
  },
  "build": {
    "appId": "app.critboard.desktop",
    "productName": "Critter",
    "files": [
      "main.js",
      "titlebar.html",
      "titlebar-preload.js",
      "page-preload.js",
      "assets/**/*",
      "www/**/*",
      "updater.js",
      "update.html",
      "update-preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "booskers",
        "repo": "crittervtt"
      }
    ]
  },
  "critterSetup": {
    "name": "Critter VTT",
    "accent": "#ff5c00",
    "description": "Critter VTT: a tabletop dice roller and battle map, as a desktop app.",
    "dataDirs": [
      "Critboard",
      "Critter"
    ],
    "artifactName": "Critter-Setup"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/booskers/crittervtt.git"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
